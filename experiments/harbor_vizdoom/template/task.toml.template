schema_version = "1.4"

artifacts = [
    { source = "/vizdoom-results/result.json", service = "vizdoom" },
    { source = "/vizdoom-results/events.jsonl", service = "vizdoom" },
    { source = "/vizdoom-results/recording.mp4", service = "vizdoom" },
]

[task]
name = {{task_name}}
description = {{description}}
authors = [{ name = "ViZDoom" }]
keywords = {{keywords}}

[metadata]
difficulty = {{difficulty}}
category = "embodied-agent"
family = {{family}}
environment_id = {{environment_id}}
display_name = {{display_name}}
level = {{level_name}}
frame_skip = 4

[agent]
timeout_sec = {{agent_timeout_sec}}.0

[verifier]
timeout_sec = 120.0
environment_mode = "separate"

[[verifier.collect]]
service = "vizdoom"
command = 'kill -USR1 1; i=0; while [ ! -s /vizdoom-results/finalized ] && [ "$i" -lt 180 ]; do sleep 1; i=$((i + 1)); done; test -s /vizdoom-results/recording.mp4'
timeout_sec = 240.0

[environment]
build_timeout_sec = 900.0
cpus = 2
memory_mb = 4096
storage_mb = 10240

[[environment.mcp_servers]]
name = "vizdoom"
transport = "streamable-http"
url = "http://vizdoom:8000/mcp"
args = []

[verifier.env]
EXPECTED_ENVIRONMENT_ID = {{environment_id}}
EXPECTED_MAX_DECISIONS = "{{max_decisions}}"

[environment.env]
